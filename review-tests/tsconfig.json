{
    "extends": "../packages/plugin/tsconfig.json",
    "compilerOptions": {
        "rootDir": "..",
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "noEmit": true,
        "typeRoots": ["../packages/plugin/node_modules/@types", "../packages/plugin/node_modules"],
        "lib": ["ESNext"],
        "paths": {
            "@magic-context/core/*": ["src/*"],
            "@cortexkit/retina-local-fs/*": [
                "../retina-local-fs/dist/types/*",
                "../retina-local-fs/src/*"
            ]
        }
    },
    "include": ["*.ts"],
    "exclude": [],
    "references": []
}
